<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Deep Obsidian Frosted Glass Gradient -->
    <gradient
        android:angle="270"
        android:startColor="#851F2536"
        android:endColor="#A8121520" />
    <!-- iOS 26dp Corner Radius -->
    <corners android:radius="26dp" />
    <!-- Luminous cut-glass specular rim -->
    <stroke
        android:width="1.5dp"
        android:color="#48FFFFFF" />
</shape>
