<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_wifi_item"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Wi-Fi Signal Icon -->
    <ImageView
        android:id="@+id/item_wifi_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_wifi"
        android:contentDescription="Signal" />

    <!-- Network Name (SSID) -->
    <TextView
        android:id="@+id/item_wifi_ssid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="Network Name"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FFFFFF"
        android:singleLine="true" />

    <!-- Saved Badge (if password is saved on TV) -->
    <TextView
        android:id="@+id/item_wifi_saved_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_wifi_badge_saved"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="Saved"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#C0D0E0"
        android:visibility="gone" />

    <!-- Lock Icon (if secured) -->
    <ImageView
        android:id="@+id/item_wifi_lock"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:src="@drawable/ic_lock"
        android:contentDescription="Secured" />

</LinearLayout>
